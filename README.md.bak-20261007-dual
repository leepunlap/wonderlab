python3 test/perf.py --runs 3                       # sizes + load times -> test/out/perf.json
node test/webkit_ipad.cjs                           # WebKit + iPad profile -> test/out/webkit_ipad.json

# optional: real model turns (key only via the environment; at most WL_REAL_MAX calls)
