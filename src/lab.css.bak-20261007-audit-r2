/*! Wonder Lab — lesson-page styles. AGPL-3.0 (see LICENSE). Matches the lesson site's purple AI pane. */
.wl-ic{width:1.15em;height:1.15em;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.2em}

/* ---- toggle in the AI 學伴 pane ---- */
.wl-mode{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:8px 12px;background:#f6f1ff;border-bottom:1px solid #ece4f8}
.wl-mode button{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;min-height:44px;border:1px solid #d9c9f3;background:#fff;
  color:#5a2ea0;border-radius:11px;padding:6px 8px;font:inherit;font-size:14px;font-weight:700;cursor:pointer;line-height:1.2}
.wl-mode button.on{background:#6a3fc0;border-color:#6a3fc0;color:#fff}
.wl-mode button.soon,.wl-mode button[aria-disabled="true"]{cursor:not-allowed;color:#9a8fb3;background:#f4f1f9;border-style:dashed}
.wl-mode button small{flex-basis:100%;font-size:10.5px;font-weight:600;opacity:.85;text-align:center}
/* the status line under the toggle: why Wonder Lab is not available here (coming soon, hardware lesson, old browser) */
.wl-note{margin:0;padding:6px 12px 8px;font-size:12.5px;line-height:1.5;color:#5b3fa8;background:#f6f1ff;border-bottom:1px solid #ece4f8}
.wl-note[hidden]{display:none}
.wl-left{grid-column:1/-1;font-size:12px;font-weight:700;color:#5b3fa8}
.wl-left.out{color:#c0392b}
.wl-left[hidden],body:not(.wl-labmode) .wl-left{display:none}
/* lab chips in the conversation (they look like the Q&A suggestion chips, but never send a Q&A question) */
.sq.wl-chip{min-height:44px}

/* ---- lab pane ---- */
.wl-lab{display:flex;flex-direction:column;min-width:0;min-height:0;padding:10px 0 6px 12px;box-sizing:border-box}
.wl-lab[hidden]{display:none}
body.wl-labmode .layout>.wrap{display:none}
.wl-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px}
.wl-bar button{display:inline-flex;align-items:center;gap:6px;min-height:44px;min-width:44px;border:1px solid #d9c9f3;background:#fff;color:#3b1f78;border-radius:11px;
  padding:6px 14px;font:inherit;font-size:14px;font-weight:700;cursor:pointer}
.wl-bar button:disabled{opacity:.45;cursor:default}
.wl-bar .wl-go{background:#2e9e5b;border-color:#2e9e5b;color:#fff}
.wl-bar .wl-sp{flex:1}
.wl-bar .wl-soon{opacity:1;color:#9a93ab;background:#f1eef6;border-style:dashed;font-weight:600}
.wl-bar .wl-soon small{font-size:11px;font-weight:500}
.wl-body{flex:1;min-height:0;display:grid;grid-template-columns:minmax(280px,440px) minmax(0,1fr);gap:12px}
.wl-stagecol{display:flex;flex-direction:column;gap:8px;min-width:0}
.wl-stage{position:relative;width:100%;aspect-ratio:4/3;background:#fff;border:1px solid #e1d8f2;border-radius:12px;overflow:hidden}
.wl-canvas{display:block;width:100%!important;height:100%!important;touch-action:none}
.wl-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#fbf9ff;color:#7b6f92;font-size:14px}
.wl-loading[hidden]{display:none}
.wl-mons{position:absolute;left:6px;top:6px;display:flex;flex-direction:column;gap:4px;pointer-events:none}
.wl-mon{background:#fff;border:1px solid #c9c2d6;border-radius:6px;font-size:12px;padding:2px 6px}
.wl-mon b{margin-left:6px;background:#ff8c1a;color:#fff;border-radius:4px;padding:0 6px}
.wl-list b{display:block;margin:2px 0 0;max-width:200px;max-height:72px;overflow:hidden;white-space:normal;word-break:break-all;background:#ff661a}
.wl-ask{position:absolute;left:8px;right:8px;bottom:8px;background:#fff;border:2px solid #b9a6e0;border-radius:10px;padding:6px;display:flex;gap:6px;flex-wrap:wrap}
.wl-ask[hidden]{display:none}
.wl-ask p{margin:0;width:100%;font-size:13px}
.wl-ask input{flex:1;min-width:0;font:inherit;font-size:16px;padding:6px;border:1px solid #d9c9f3;border-radius:8px}
.wl-ask button{border:0;border-radius:8px;background:#7c4dc4;color:#fff;font:inherit;padding:0 12px;min-height:44px}
.wl-pad{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.wl-pad button{display:flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #d9cff0;background:#fff;color:#3b1f78;border-radius:10px;
  touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;cursor:pointer}
.wl-pad button:active{background:#efe7fc}
.wl-hint{margin:0;font-size:12px;color:#8a7fa3}
.wl-codecol{display:flex;flex-direction:column;min-height:0;min-width:0}
.wl-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px}
.wl-tab{min-height:44px;min-width:44px;border:1px solid #d9cff0;background:#fff;color:#3b1f78;border-radius:999px;padding:5px 14px;font:inherit;font-size:13px;cursor:pointer}
.wl-tab.on{background:#6a3fc0;border-color:#6a3fc0;color:#fff}
.wl-tab.new:not(.on){border-color:#f0b429;box-shadow:0 0 0 2px #fde9b0}
.wl-bwrap{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}
.wl-blocks{flex:1;min-height:260px;border:1px solid #e1d8f2;border-radius:12px;overflow:hidden;background:#fff;position:relative}
.wl-blocks .wl-new>path:first-child,.wl-blocks .wl-new>.blocklyPath{filter:drop-shadow(0 0 3px #f0b429)}
/* shown while the program has no scripts yet */
.wl-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;
  font-size:14px;line-height:1.7;color:#8a7fa3;pointer-events:none}
.wl-empty[hidden]{display:none}
.wl-foot{margin:6px 0 0;font-size:11.5px;color:#9a8fb3}
.wl-foot a{color:#7c4dc4;display:inline-flex;align-items:center;min-height:44px;padding:0 6px}
.msg.wl-q{background:#fff8e6;border-color:#f1d98a}
.wl-chbody[hidden]{display:none}
/* the chat pane shows ONE body: the normal Q&A (#chbody) or the lab conversation (#wlbody) */
body.wl-labmode #chbody,body:not(.wl-labmode) #wlbody{display:none!important}
body.wl-labmode .chclose{min-width:44px;min-height:44px}

@media(min-width:1100px){
  .wl-lab{height:100%;overflow:hidden}
  .wl-pad,.wl-hint{flex:none}
  .wl-left{display:none}           /* the cap rows show the same numbers here */
}
@media(max-width:1099px){
  .wl-lab{padding:10px 12px 90px}
  .wl-body{grid-template-columns:1fr}
  .wl-stage{max-width:min(100%,calc(45dvh * 4 / 3));margin:0 auto}
  .wl-blocks{min-height:320px}
  .wl-bar .wl-soon .wl-why{display:none}
  /* in lab mode the chat is a bottom drawer that ends just below the stage (lab.js sets --wl-dh) */
  body.wl-labmode .chat.open{top:auto;height:var(--wl-dh,52dvh);min-height:240px;border-radius:16px 16px 0 0;box-shadow:0 -8px 30px rgba(60,30,110,.25)}
  body.wl-labmode.chatopen{overflow:auto}
  /* keep the drawer for the conversation: compact head, class line + turns left only (no cap rows), no footnote */
  body.wl-labmode .chat.open .chhead{padding:6px 12px}
  body.wl-labmode .chat.open .chhead small,body.wl-labmode .chat.open .cprow,body.wl-labmode .chat.open .chnote{display:none}
  body.wl-labmode .chat.open .chcaps{padding:4px 10px;border-bottom:0}
  body.wl-labmode .chat.open .chcaps:not(:has(.cpclass:not([hidden]),.wl-left:not([hidden]))){display:none}
  body.wl-labmode .chat.open .wl-mode{padding:6px 10px}
  body.wl-labmode .chat.open .chform{padding:8px 10px}
  body.wl-labmode .chat.open .chform textarea{height:44px;min-height:44px;padding:9px 10px}
  body.wl-labmode .chat.open .cpclass{font-size:11.5px;padding:3px 8px;margin-bottom:2px}
  body.wl-labmode .chat.open .wl-left{font-size:11.5px}
}
/* short screens (phones): the lesson bar gives its room to the stage and the conversation while the lab is open */
@media(max-width:1099px) and (max-height:760px){
  body.wl-labmode .lessonbar{display:none}
  /* the drawer head shrinks to its close button, at the right end of the toggle row */
  body.wl-labmode .chat.open .chhead{position:absolute;top:0;right:0;z-index:2;padding:6px 6px 0 0;background:none}
  body.wl-labmode .chat.open .chhead .chico,body.wl-labmode .chat.open .chhead>div{display:none}
  body.wl-labmode .chat.open .chclose{color:#6a3fc0}
  body.wl-labmode .chat.open .wl-mode{padding-right:56px}
}
/* tablets held sideways (e.g. iPad 10.2 at 1080 x 810): stage and blocks side by side above the drawer */
@media(max-width:1099px) and (orientation:landscape) and (min-width:900px){
  .wl-body{grid-template-columns:minmax(260px,42%) 1fr}
  body.wl-labmode .chat.open{height:var(--wl-dh,40dvh)}
}
/* phones: one toolbar row (stop and undo show their icon only; the export label stacks) */
@media(max-width:520px){
  .wl-bar{gap:6px}
  .wl-bar button{padding:6px 12px}
  .wl-bar .wl-ionly span{display:none}
  .wl-bar .wl-ionly{padding:6px 10px;justify-content:center}
  .wl-bar .wl-soon{display:inline-grid;grid-template-columns:auto auto;grid-template-rows:auto auto;column-gap:6px;row-gap:0;line-height:1.15;padding:5px 10px}
  .wl-bar .wl-soon .wl-ic{grid-row:1/3;align-self:center}
}
